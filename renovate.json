{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Puerto_Rico",
  "schedule": [
    "* 0-4 * * *"
  ],
  "automergeSchedule": [
    "* 0-4 * * *"
  ],
  "updateNotScheduled": false,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "commitHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "automerge": false,
  "ignoreTests": false,
  "internalChecksAsSuccess": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Application images are advanced by the existing verified release workflow",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/javadevjt/**"
      ],
      "enabled": false
    },
    {
      "description": "Automerge tested dependencies through the protected GitHub CI check",
      "matchManagers": [
        "maven"
      ],
      "matchFileNames": [
        "pom.xml"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "matchCurrentVersion": "!/^0[.]/"
    },
    {
      "description": "Keep the embedded Tomcat property on the 11.0 maintenance line",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "org.apache.tomcat.embed:tomcat-embed-core"
      ],
      "matchDatasources": [
        "maven"
      ],
      "allowedVersions": "[11.0.30,11.1)",
      "matchFileNames": [
        "pom.xml"
      ]
    },
    {
      "description": "Automerge eligible embedded Tomcat updates through the required Renovate dependency CI check",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "org.apache.tomcat.embed:tomcat-embed-core"
      ],
      "matchDatasources": [
        "maven"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "matchFileNames": [
        "pom.xml"
      ],
      "matchCurrentVersion": "!/^0[.]/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "matchStrings": [
        "<tomcat\\.version>(?<currentValue>[^<\\s]+)</tomcat\\.version>"
      ],
      "depNameTemplate": "org.apache.tomcat.embed:tomcat-embed-core",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven",
      "managerFilePatterns": [
        "/^pom\\.xml$/"
      ]
    }
  ]
}
